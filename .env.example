# ── 运行环境 ──────────────────────────────────────────────
# 选择语音栈配置：demo | china_landing
VOICE_PROFILE=demo

# ── LiveKit ───────────────────────────────────────────────
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── SIP Trunk（demo：Twilio；china_landing：阿里云）────────
# demo
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# china_landing
ALIYUN_SIP_ENDPOINT=sip.aliyuncs.com
ALIYUN_SIP_ACCESS_KEY=your_aliyun_access_key
ALIYUN_SIP_ACCESS_SECRET=your_aliyun_access_secret
ALIYUN_PHONE_NUMBER=0571xxxxxxxx

# ── demo A/B 切换 ─────────────────────────────────────────
# realtime  → OpenAI Realtime API（默认，低延迟一体化）
# cascaded  → 阿里云三件套 Paraformer STT + Qwen LLM + CosyVoice TTS
DEMO_VOICE_MODE=realtime

# ── 语音栈：demo realtime（OpenAI）────────────────────────
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin

# ── 语音栈：demo cascaded（阿里云 DashScope）──────────────
# 统一 API Key（STT / LLM / TTS 共用同一把 DashScope key）
DASHSCOPE_API_KEY=sk-your_dashscope_api_key

# LLM 端点：
#   北京（默认）： https://dashscope.aliyuncs.com/compatible-mode/v1
#   国际版：       https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_LLM_MODEL=qwen-plus

# CosyVoice v2 音色（STT/TTS WS 端点固定走 dashscope.aliyuncs.com 北京节点）
# 可选音色：longcheng（轻柔温暖）/ longhua（标准男声）/ longxiaochun（清晰女声）/ longnan（正式男声）
DASHSCOPE_TTS_VOICE=longcheng

# Paraformer STT 模型（一般不需要改）
DASHSCOPE_STT_MODEL=paraformer-realtime-v2

# 热词表 ID：在 DashScope 控制台"语音识别 → 热词管理"创建后填入
# 建议添加：蓝色鲸鱼、粤、沪、京、苏、浙、鲁、川 等高频车牌省份字
# 留空则不启用热词（不影响正常识别）
DASHSCOPE_STT_VOCABULARY_ID=

# ── 语音栈：china_landing（国内 LLM + ASR + TTS）─────────
# LLM（OpenAI 兼容端点，可填 Qwen / DeepSeek / GLM）
CHINA_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHINA_LLM_API_KEY=your_dashscope_api_key
CHINA_LLM_MODEL=qwen-plus

# ASR（国内语音识别）
CHINA_ASR_APPKEY=your_asr_appkey
CHINA_ASR_TOKEN=your_asr_token

# TTS（Qwen3-TTS 或其他）
CHINA_TTS_APPKEY=your_tts_appkey
CHINA_TTS_TOKEN=your_tts_token

# ── 数据库 ────────────────────────────────────────────────
# demo：留空则自动使用 SQLite（./data/visitors.db）
# production：填写 PostgreSQL DSN
DATABASE_URL=

# ── Agent / SIP 路由（一般不需要改）─────────────────────────
AGENT_NAME=visitor-agent
SIP_ROOM_PREFIX=call-

# ── 企业微信 Webhook ──────────────────────────────────────
# 获取方式：企业微信群 → 群设置 → 添加群机器人 → 新建 → 复制 Webhook 地址
# 留空时 dry-run：消息打印到日志，不发 HTTP 请求（本地开发可不填）
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key
